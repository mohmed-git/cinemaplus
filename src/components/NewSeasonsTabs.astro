---
/**
 * Seasons / episodes browser for NEW (SSR) works.
 *
 * Visually identical to the old SeasonsTabs but every link points at the
 * /w + /gw SSR namespace (newSeasonRoute / newEpisodeRoute) instead of the
 * route-coupled static helpers. Adds an episode quick-filter for long lists
 * so these pages feel as interactive as the old ones.
 */
import type { Title } from '../lib/types';
import { newEpisodeRoute } from '../lib/routes';

interface Props {
  title: Title;
}
const { title } = Astro.props;
const seasons = title.seasons || [];
const initial = seasons[0]?.season ?? 1;
const totalEpisodes = seasons.reduce((n, s) => n + (s.episodes?.length || 0), 0);
const showFilter = totalEpisodes > 16;
---

<div class="glass-panel overflow-hidden" data-new-seasons>
  <!-- Tabs -->
  <div class="flex flex-wrap items-center gap-2 border-b border-white/[0.06] px-4 py-3">
    {seasons.map((s) => (
      <button
        type="button"
        class={`new-season-tab tab ${s.season === initial ? 'tab-active' : 'tab-inactive'}`}
        data-season={s.season}
      >
        الموسم {s.season}
        <span class="mr-1 text-[11px] opacity-75">({s.episodes?.length || 0})</span>
      </button>
    ))}
  </div>

  {showFilter && (
    <div class="border-b border-white/[0.06] px-4 py-3">
      <label class="relative block">
        <span class="sr-only">ابحث عن رقم الحلقة</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-500"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          type="search"
          inputmode="numeric"
          data-episode-filter
          placeholder="ابحث عن رقم الحلقة…"
          class="w-full rounded-xl border border-white/[0.06] bg-white/[0.04] py-2.5 pr-10 pl-3 text-sm text-white placeholder:text-gray-500 focus:border-brand-500/50 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
        />
      </label>
    </div>
  )}

  <!-- Panels -->
  {seasons.map((s) => (
    <div class={`new-season-panel p-4 ${s.season === initial ? '' : 'hidden'}`} data-season={s.season}>
      <ul class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
        {s.episodes.map((ep) => (
          <li data-episode={ep.episode}>
            <a
              href={newEpisodeRoute(title.slug, s.season, ep.episode)}
              class="group relative flex items-center gap-3 rounded-xl bg-white/[0.03] border border-white/[0.05] px-3 py-2.5 text-sm text-gray-200 transition-all duration-300 hover:bg-gradient-to-l hover:from-brand-600/20 hover:to-neon-fuchsia/10 hover:border-brand-500/40 hover:text-white hover:shadow-[0_0_20px_-6px_rgba(168,85,247,0.5)]"
            >
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-brand-600/30 to-neon-fuchsia/20 text-brand-300 group-hover:from-brand-500 group-hover:to-neon-fuchsia group-hover:text-white transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5"><path d="M8 5v14l11-7z" /></svg>
              </span>
              <div class="min-w-0 flex-1">
                <div class="font-semibold line-clamp-1">{ep.title || `الحلقة ${ep.episode}`}</div>
                <div class="text-[10px] text-gray-500 mt-0.5">{ep.servers?.length || 0} سيرفر</div>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="hidden py-6 text-center text-sm text-gray-500" data-empty>لا توجد حلقة بهذا الرقم.</p>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-new-seasons]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.new-season-tab');
    const panels = root.querySelectorAll<HTMLElement>('.new-season-panel');
    const filter = root.querySelector<HTMLInputElement>('[data-episode-filter]');

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.season;
        tabs.forEach((b) => {
          const active = b.dataset.season === key;
          b.classList.toggle('tab-active', active);
          b.classList.toggle('tab-inactive', !active);
        });
        panels.forEach((p) => p.classList.toggle('hidden', p.dataset.season !== key));
        if (filter) { filter.value = ''; applyFilter(); }
      });
    });

    function applyFilter() {
      const q = (filter?.value || '').trim();
      panels.forEach((p) => {
        if (p.classList.contains('hidden')) return;
        let shown = 0;
        p.querySelectorAll<HTMLElement>('[data-episode]').forEach((li) => {
          const match = !q || (li.dataset.episode || '').includes(q);
          li.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        const empty = p.querySelector<HTMLElement>('[data-empty]');
        if (empty) empty.classList.toggle('hidden', shown > 0);
      });
    }
    filter?.addEventListener('input', applyFilter);
  });
</script>
