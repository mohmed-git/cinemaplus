---
/**
 * SSR detail page for a NEW (CSV-ingested) work.
 *
 * Self-contained (does not reuse the route-coupled static detail components) so
 * every internal link points at the /w + /gw SSR namespace. The full work is
 * fetched from its detail shard at request time; nothing is bundled.
 *
 * The body now reuses the SAME rich layout as the old static pages
 * (NewTitleDetailContent mirrors TitleDetailContent) so new pages no longer
 * look "empty". The <title> for new works intentionally drops the "سينما بلس"
 * brand suffix (Base `noBrand`) per the site owner's request.
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewTitleDetailContent from '../../components/NewTitleDetailContent.astro';
import { SITE } from '../../lib/site';
import { newGatewayRoute, newEpisodeRoute } from '../../lib/routes';
import { sortedSeasons } from '../../lib/episodeRoutes';
import { loadNewWork, loadSubcat, type SubcatCard } from '../../lib/newWorks';
import { SUB_BY_KEY, subcatRoute } from '../../lib/subcategories';
import {
  splitGenres,
  uniquifyPlot,
  getRatingInfo,
  getWorkTitle,
  buildMetaDescription,
  buildWorkJsonLd,
  getWorkImage,
} from '../../lib/detailContent';
import { listingRoute } from '../../lib/routes';

const { slug } = Astro.params;
const title = slug ? await loadNewWork(slug, Astro.url) : undefined;
if (!title) return new Response('Not found', { status: 404 });

const sub = (title as any).subcategory as string | undefined;
const subDef = sub ? SUB_BY_KEY[sub] : undefined;
const section = title.category === 'movie' ? 'movies' : title.category === 'anime' ? 'anime' : 'series';
const isMovie = title.category === 'movie' || title.episodes_count <= 1;
const detailKind = title.category === 'movie' ? 'movie' : title.category === 'anime' ? 'anime' : 'series';
const genres = splitGenres(title.genre);
const ratingInfo = getRatingInfo(title as any);
const rating = ratingInfo ? ratingInfo.value : null;
// For series/anime the primary CTA goes to the FIRST EPISODE PAGE (then to
// watch from there), matching the old-site flow: work → episode → watch.
// Movies go straight to the watch gateway.
const firstSeasonSorted = sortedSeasons(title)[0];
const firstEp = firstSeasonSorted?.episodes?.[0];
const hasEpisodes = !isMovie && !!firstSeasonSorted && !!firstEp;
const canWatch = (title.seasons?.[0]?.episodes?.[0]?.servers?.length || 0) > 0 || hasEpisodes;
const watchHref = hasEpisodes
  ? newEpisodeRoute(title.slug, firstSeasonSorted.season, firstEp.episode)
  : newGatewayRoute(title.slug);
const kindLabel = title.category === 'movie' ? 'فيلم' : title.category === 'anime' ? 'أنمي' : 'مسلسل';
const workTitle = getWorkTitle(title as any);

// Similar works from the same sub-category index (cheap, slim cards).
let similarCards: SubcatCard[] = [];
if (sub) {
  const list = await loadSubcat(sub, Astro.url);
  similarCards = list.filter((e) => e.slug !== title.slug).slice(0, 12);
}
// Map slim sub-cards onto the shape PosterCard/Grid expect.
const similar = similarCards.map((e) => ({
  slug: e.slug,
  clean_title: e.clean_title,
  category: e.category,
  category_label: e.category_label,
  poster: e.poster,
  url: e.url!,
  year: e.year,
  rating: e.rating,
  votes: e.votes,
  episodes_count: e.episodes_count,
  seasons_count: e.seasons_count,
})) as any;

// Uniquified plot so this page does not duplicate the older mirror site's text.
const uniquePlot = uniquifyPlot(title as any, detailKind as any);
const displayStory = uniquePlot || title.story || title.description || '';

// Title WITHOUT the "سينما بلس" brand suffix (owner request for new works).
const pageTitle = `مشاهدة ${kindLabel} ${workTitle} مترجم اون لاين`;
const pageDescription = buildMetaDescription(title as any, detailKind as any);

const pageUrl = new URL(newGatewayRoute(title.slug), SITE.url).toString().split('?')[0];
const watchUrl = new URL(watchHref, SITE.url).toString().split('?')[0];
const categoryLabel = title.category === 'movie' ? 'أفلام' : title.category === 'anime' ? 'أنمي' : 'مسلسلات';
const categoryHref = listingRoute(title.category as 'movie' | 'series' | 'anime');
const ogImage = getWorkImage(title as any, SITE.url) ?? title.poster ?? undefined;
const jsonLd = buildWorkJsonLd(title as any, detailKind as any, {
  siteUrl: SITE.url,
  siteName: SITE.name,
  pageUrl,
  watchUrl: canWatch ? watchUrl : undefined,
  categoryLabel,
  categoryHref,
});

function quality(s: string): string {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 17 + s.charCodeAt(i)) >>> 0;
  return h % 5 === 0 ? '4K' : 'HD';
}
---

<Base title={pageTitle} description={pageDescription} image={ogImage} ogType={isMovie ? 'video.movie' : 'video.tv_show'} jsonLd={jsonLd} section={section as any} noBrand>
  <section class="relative -mt-16 overflow-hidden pt-16 lg:-mt-[72px] lg:pt-[72px]">
    <div class="absolute inset-0 -z-10">
      {title.poster && (
        <img src={title.poster} alt="" aria-hidden="true" loading="eager" referrerpolicy="no-referrer" class="h-full w-full scale-110 object-cover opacity-40 blur-3xl" />
      )}
      <div class="absolute inset-0 hero-overlay"></div>
      <div class="orb -top-10 right-10 h-72 w-72 bg-brand-600"></div>
      <div class="orb -left-10 top-40 h-80 w-80 bg-gold-500"></div>
    </div>

    <div class="container-app relative pb-12 pt-6 md:pb-20 md:pt-10">
      <Breadcrumbs items={[
        { label: 'الرئيسية', href: '/' },
        ...(subDef ? [{ label: subDef.label, href: subcatRoute(subDef.code) }] : []),
        { label: workTitle },
      ]} />

      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10">
        <div class="flex justify-center md:col-span-4 md:justify-start lg:col-span-3">
          <div class="relative">
            <div class="relative aspect-[2/3] w-[240px] overflow-hidden rounded-3xl shadow-2xl ring-1 ring-white/10 sm:w-[280px] md:w-full">
              {title.poster ? (
                <img src={title.poster} alt={workTitle} loading="eager" referrerpolicy="no-referrer" class="h-full w-full object-cover" />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface-3 to-surface-5 p-6 text-center text-sm text-gray-400">{workTitle}</div>
              )}
              <div class="badge-hd absolute right-3 top-3 shadow-[0_4px_14px_rgba(251,191,36,0.45)]">{quality(title.slug)}</div>
            </div>
            <div class="absolute -inset-4 -z-10 rounded-3xl bg-gradient-to-br from-brand-600/30 to-gold-500/25 blur-2xl"></div>
          </div>
        </div>

        <div class="space-y-5 md:col-span-8 lg:col-span-9">
          <div class="flex flex-wrap items-center gap-2">
            <span class="chip-brand">{kindLabel}</span>
            {ratingInfo && (
              <span class="chip-surface inline-flex items-center gap-1" title={`التقييم من ${ratingInfo.source}`}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-amber-400"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                {ratingInfo.value}
                <span class="text-[10px] text-gray-400">{ratingInfo.source}</span>
              </span>
            )}
            {title.year && <span class="chip-surface">{title.year}</span>}
            {title.country && <span class="chip-surface">{title.country}</span>}
            {!isMovie && <span class="chip-surface">{title.episodes_count} حلقة</span>}
          </div>

          <h1 class="font-display text-3xl font-extrabold leading-[1.1] text-white md:text-4xl lg:text-5xl">{workTitle}</h1>

          {genres.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {genres.map((g) => <span class="inline-flex items-center rounded-full border border-white/[0.06] bg-white/[0.04] px-3 py-1 text-xs text-gray-300">{g}</span>)}
            </div>
          )}

          {canWatch && (
            <div class="flex flex-wrap gap-3 pt-1">
              <a href={watchHref} class="btn-primary px-7 py-3.5 text-base">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M8 5v14l11-7z" /></svg>
                {isMovie ? 'شاهد الآن' : 'ابدأ المشاهدة'}
              </a>
            </div>
          )}

          {displayStory && (
            <div class="pt-2">
              <h2 class="mb-2 text-lg font-bold text-white">{isMovie ? `قصة فيلم ${workTitle}` : `قصة ${workTitle}`}</h2>
              <p class="text-sm leading-relaxed text-gray-300/90">{displayStory}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <NewTitleDetailContent title={title} kind={detailKind as any} similar={similar} />
</Base>
