---
/**
 * SEASON page for a NEW (SSR) series/anime — /w/<slug>/c/<season>.
 *
 * Lists every episode of the season (each links to its own /w/.../e/<n> page)
 * plus a "watch first episode" shortcut, mirroring the old season page but on
 * the /w SSR namespace with the brand-free title. SSR (not prerendered).
 */
export const prerender = false;

import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Grid from '../../../../components/Grid.astro';
import SectionHeader from '../../../../components/SectionHeader.astro';
import { loadNewWork, loadSubcat, type SubcatCard } from '../../../../lib/newWorks';
import { findEpisode, sortedSeasons } from '../../../../lib/episodeRoutes';
import {
  newDetailRoute,
  newSeasonRoute,
  newEpisodeRoute,
  newGatewayRoute,
} from '../../../../lib/routes';
import { SITE } from '../../../../lib/site';
import { SUB_BY_KEY, subcatRoute } from '../../../../lib/subcategories';
import { cleanBrand, getWorkTitle, splitGenres } from '../../../../lib/detailContent';

const { slug, season } = Astro.params;
const seasonNumber = Number.parseInt(season ?? '', 10);
const title = slug ? await loadNewWork(slug, Astro.url) : undefined;

const isEpisodic =
  !!title &&
  (title.category === 'series' || title.category === 'anime') &&
  title.episodes_count > 1 &&
  (title.seasons?.length || 0) > 0;

if (!title || !isEpisodic || Number.isNaN(seasonNumber)) {
  return new Response('Not found', { status: 404 });
}

const { season: resolvedSeason } = findEpisode(title, seasonNumber, 1);
if (!resolvedSeason || resolvedSeason.season !== seasonNumber) {
  return new Response('Not found', { status: 404 });
}

const kind = title.category === 'anime' ? 'anime' : 'series';
const typeLabel = kind === 'anime' ? 'أنمي' : 'مسلسل';
const categoryLabel = kind === 'anime' ? 'أنمي' : 'مسلسلات';
const workTitle = getWorkTitle(title as any);
const titleRoute = newDetailRoute(title.slug);
const episodes = resolvedSeason.episodes;
const firstEp = episodes[0];
const genres = splitGenres(title.genre);

const sub = (title as any).subcategory as string | undefined;
const subDef = sub ? SUB_BY_KEY[sub] : undefined;
const allSeasons = sortedSeasons(title);

const pageTitle = `مشاهدة ${typeLabel} ${workTitle} الموسم ${seasonNumber} مترجم اون لاين`;
const description = `جميع حلقات ${typeLabel} ${workTitle} الموسم ${seasonNumber} مترجمة بجودة عالية اون لاين — اختر الحلقة التي تريد مشاهدتها.`;
const canonical = new URL(newSeasonRoute(title.slug, seasonNumber), SITE.url).toString();

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400'
);
---

<Base
  title={pageTitle}
  description={description}
  canonical={canonical}
  image={title.poster ?? undefined}
  ogType="video.tv_show"
  section={kind}
  noBrand
>
  <section class="container-app py-8 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'الرئيسية', href: '/' },
        { label: categoryLabel, href: subDef ? subcatRoute(subDef.code) : titleRoute },
        { label: workTitle, href: titleRoute },
        { label: `الموسم ${seasonNumber}` },
      ]}
    />

    <div class="mt-6 glass-panel overflow-hidden">
      <div class="relative grid grid-cols-1 gap-6 p-5 md:grid-cols-[200px_1fr] md:p-7">
        <div class="absolute inset-0 -z-10">
          {title.poster && <img src={title.poster} alt="" aria-hidden="true" loading="eager" referrerpolicy="no-referrer" class="h-full w-full scale-110 object-cover opacity-25 blur-3xl" />}
          <div class="absolute inset-0 bg-gradient-to-l from-surface-0 via-surface-0/95 to-surface-0/80"></div>
        </div>
        <div class="mx-auto w-[170px] md:w-full">
          <div class="relative aspect-[2/3] overflow-hidden rounded-2xl bg-surface-3 ring-1 ring-white/10">
            {title.poster ? (
              <img src={title.poster} alt={workTitle} loading="eager" decoding="async" referrerpolicy="no-referrer" class="h-full w-full object-cover" />
            ) : (
              <div class="flex h-full items-center justify-center p-4 text-center text-sm text-gray-400">{workTitle}</div>
            )}
          </div>
        </div>
        <div class="flex flex-col justify-center">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="chip-brand">{typeLabel}</span>
            {title.year && <span class="chip-surface">{title.year}</span>}
            <span class="chip-surface">الموسم {seasonNumber}</span>
            <span class="chip-surface">{episodes.length} حلقة</span>
          </div>
          <h1 class="font-display text-2xl font-extrabold leading-[1.15] text-white md:text-3xl">{workTitle} — الموسم {seasonNumber}</h1>
          {genres.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {genres.map((g) => <span class="rounded-full border border-white/[0.06] bg-white/[0.04] px-3 py-1 text-xs text-gray-300">{g}</span>)}
            </div>
          )}
          <div class="mt-5 flex flex-wrap gap-3">
            {firstEp && (
              <a href={newEpisodeRoute(title.slug, seasonNumber, firstEp.episode)} class="btn-primary px-7 py-3.5 text-base">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M8 5v14l11-7z" /></svg>
                شاهد الحلقة الأولى
              </a>
            )}
            <a href={titleRoute} class="btn-secondary px-6 py-3.5 text-base">صفحة العمل</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Season switcher -->
    {allSeasons.length > 1 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {allSeasons.map((s) => (
          <a
            href={newSeasonRoute(title.slug, s.season)}
            class={`tab ${s.season === seasonNumber ? 'tab-active' : 'tab-inactive'}`}
          >
            الموسم {s.season}
          </a>
        ))}
      </div>
    )}

    <!-- Episodes of this season -->
    <section class="mt-6 glass-panel p-5 md:p-6">
      <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-white">
        <span class="flex h-6 w-1 rounded-full bg-gradient-to-b from-brand-400 to-gold-400"></span>
        حلقات الموسم {seasonNumber}
      </h2>
      <ul class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
        {episodes.map((ep) => (
          <li>
            <a
              href={newEpisodeRoute(title.slug, seasonNumber, ep.episode)}
              class="group flex items-center gap-3 rounded-xl border border-white/[0.05] bg-white/[0.03] px-3 py-2.5 text-sm text-gray-200 transition-all duration-300 hover:border-brand-500/40 hover:bg-brand-600/15 hover:text-white"
            >
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-brand-600/30 to-neon-fuchsia/20 text-brand-300 group-hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5"><path d="M8 5v14l11-7z" /></svg>
              </span>
              <div class="min-w-0 flex-1">
                <div class="font-semibold line-clamp-1">{ep.title || `الحلقة ${ep.episode}`}</div>
                <div class="text-[10px] text-gray-500 mt-0.5">الحلقة {ep.episode}</div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </section>
</Base>
